# Copy this file to .env and adjust values if needed.
# .env itself is git-ignored — never commit real secrets.

# Used by the app (via the `pg` driver) to connect to Postgres.
# When running with `docker compose up`, "db" is the Postgres service
# name in docker-compose.yml — Docker's internal DNS resolves it.
DATABASE_URL=postgresql://taskapi:taskapi@db:5432/taskapi

# Used by the Postgres container itself (docker-compose.yml reads these).
POSTGRES_USER=taskapi
POSTGRES_PASSWORD=taskapi
POSTGRES_DB=taskapi

# "postgres" to use the Dockerized Postgres, "sqlite" to fall back to
# the A2 SQLite file with zero setup (no Docker required).
DB_DRIVER=postgres

PORT=3000
